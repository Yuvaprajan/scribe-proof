NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- OCR stack (keep local and Docker in sync) ---
SCRIBEPROOF_OCR_MODE=trocr
SCRIBEPROOF_USE_PADDLE=true
SCRIBEPROOF_ALLOW_MOCK_FALLBACK=false
SCRIBEPROOF_WARMUP_MODELS=true
SCRIBEPROOF_PRINT_OCR_PRIMARY=true

# TrOCR handwritten (line HTR). Prefer large+CUDA when available.
SCRIBEPROOF_TROCR_MODEL=microsoft/trocr-large-handwritten
# SCRIBEPROOF_TROCR_MODEL=microsoft/trocr-base-handwritten
SCRIBEPROOF_TROCR_DTYPE=auto
SCRIBEPROOF_TROCR_TARGET_H=80
SCRIBEPROOF_TROCR_MAX_UPSCALE=3.5

# PaddleOCR detection + print recognition
SCRIBEPROOF_PADDLE_OCR_VERSION=PP-OCRv4
SCRIBEPROOF_PADDLE_LANG=en
SCRIBEPROOF_PADDLE_GPU=false

# Line variants / escalate
SCRIBEPROOF_LINE_VARIANTS=clahe
SCRIBEPROOF_ESCALATE_VARIANTS=raw,clahe,adaptive_binarized,denoised

# Detection safety (page-sized boxes never reach TrOCR)
SCRIBEPROOF_BBOX_MAX_AREA_RATIO=0.22
SCRIBEPROOF_BBOX_MAX_HEIGHT_RATIO=0.18
SCRIBEPROOF_BBOX_MAX_HEIGHT_PX=140
SCRIBEPROOF_BBOX_MIN_HEIGHT_PX=8
SCRIBEPROOF_BBOX_MAX_PROJECTED_LINES=2

# Decision thresholds (conservative; confidence is UNCALIBRATED evidence score)
SCRIBEPROOF_ACCEPTED_MIN_SCORE=0.72
SCRIBEPROOF_ACCEPTED_MAX_UNCERTAINTY=0.28
SCRIBEPROOF_ILLEGIBLE_MIN_VISUAL=0.28
SCRIBEPROOF_REQUIRE_TROCR_ACCEPTED=true

# Lexicon: near-exact repairs only
SCRIBEPROOF_LEXICON_ENABLED=true
SCRIBEPROOF_LEXICON_MAX_DIST=0.18
SCRIBEPROOF_LEXICON_MIN_FUZZ=88
# SCRIBEPROOF_DOMAIN_LEXICON=custom,terms

# Qwen3-VL — layout/category ADVISORY only (never free OCR rewrite)
# Leave disabled unless you have a key. Never commit real keys.
SCRIBEPROOF_QWEN_ENABLED=false
SCRIBEPROOF_QWEN_API_KEY=
SCRIBEPROOF_QWEN_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
SCRIBEPROOF_QWEN_MODEL=qwen/qwen3-vl-8b-instruct
SCRIBEPROOF_QWEN_LAYOUT_MIN_IOU=0.25
SCRIBEPROOF_QWEN_LAYOUT_MAX_AREA=0.35

# Optional VLM verifier — selects among OCR candidates or ILLEGIBLE only
SCRIBEPROOF_VERIFIER_ENABLED=false
SCRIBEPROOF_VERIFIER_PROVIDER=auto
SCRIBEPROOF_VERIFIER_API_KEY=
SCRIBEPROOF_VERIFIER_ENDPOINT=https://api.openai.com/v1/chat/completions
SCRIBEPROOF_VERIFIER_MODEL=gpt-4o-mini

# CORS / data
SCRIBEPROOF_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# SCRIBEPROOF_DATA_DIR=
# SCRIBEPROOF_DATABASE_URL=
