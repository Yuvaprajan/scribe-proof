NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Adaptive OCR: Paddle primary for printed_text; TrOCR primary for handwriting.
SCRIBEPROOF_OCR_MODE=trocr
SCRIBEPROOF_USE_PADDLE=true
SCRIBEPROOF_ALLOW_MOCK_FALLBACK=false
SCRIBEPROOF_WARMUP_MODELS=true
SCRIBEPROOF_PRINT_OCR_PRIMARY=true

# Prefer large + CUDA for handwriting accuracy/speed (fp16 auto on <=6GB VRAM).
SCRIBEPROOF_TROCR_MODEL=microsoft/trocr-large-handwritten
# SCRIBEPROOF_TROCR_MODEL=microsoft/trocr-base-handwritten
SCRIBEPROOF_TROCR_DTYPE=auto
SCRIBEPROOF_PADDLE_OCR_VERSION=PP-OCRv4
SCRIBEPROOF_PADDLE_LANG=en
# Keep Paddle on CPU while TrOCR uses CUDA (avoids VRAM contention on 4GB cards)
SCRIBEPROOF_PADDLE_GPU=false

# Fast path (CLAHE); hard handwriting lines auto-escalate to all four variants.
SCRIBEPROOF_LINE_VARIANTS=clahe
SCRIBEPROOF_ESCALATE_VARIANTS=raw,clahe,adaptive_binarized,denoised
# Optional domain lexicon boosts (comma-separated), merged with built-in clinical terms
# SCRIBEPROOF_DOMAIN_LEXICON=your,custom,terms

# Qwen3-VL document understanding (category + layout + line items)
# Recommended for India / global: OpenRouter (OpenAI-compatible)
#   1) Sign up: https://openrouter.ai/keys
#   2) Model page: https://openrouter.ai/qwen/qwen3-vl-8b-instruct
SCRIBEPROOF_QWEN_ENABLED=false
SCRIBEPROOF_QWEN_API_KEY=
SCRIBEPROOF_QWEN_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
SCRIBEPROOF_QWEN_MODEL=qwen/qwen3-vl-8b-instruct
# Stronger (costlier): qwen/qwen3-vl-32b-instruct | qwen/qwen3-vl-30b-a3b-instruct
#
# Alibaba Bailian/DashScope often blocks India signups — skip unless you have access:
# SCRIBEPROOF_QWEN_ENDPOINT=https://dashscope-intl.aliyuncs.com/compatible-mode/v1/chat/completions
# SCRIBEPROOF_QWEN_MODEL=qwen3-vl-plus
#
# Other options: Fireworks / HF Inference / self-hosted vLLM on Runpod (same OpenAI chat format)

# Optional line verifier (picks existing candidate or ILLEGIBLE only)
SCRIBEPROOF_VERIFIER_ENABLED=false
SCRIBEPROOF_VERIFIER_PROVIDER=auto
SCRIBEPROOF_VERIFIER_API_KEY=
SCRIBEPROOF_VERIFIER_ENDPOINT=https://api.openai.com/v1/chat/completions
SCRIBEPROOF_VERIFIER_MODEL=gpt-4o-mini
